# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  cp .env.example .env

# Supabase 연결 문자열 (필수)
# Supabase 대시보드 → Project Settings → Database → Connection string
#   - 서버리스(Vercel)에서는 "Connection pooling"(Transaction, 포트 6543) 문자열 권장
#   - 비밀번호 부분([YOUR-PASSWORD])을 실제 DB 비밀번호로 교체
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# 세션 유효시간(시간) — 선택
SESSION_HOURS=12

# 로컬에서 DB 없이 데모로 띄울 때만 사용(인메모리, 재시작 시 초기화)
# USE_PG_MEM=1

# ── 텔레그램 알림 (선택) ──────────────────────────────
# 없으면 기능 전체가 비활성화되고 인앱 알림만 동작합니다.
# 1) 텔레그램에서 @BotFather 에게 /newbot → 봇 이름·아이디 정하면 토큰 발급
# TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 2) 위에서 정한 봇 아이디(@ 제외)
# TELEGRAM_BOT_USERNAME=acm_workspace_bot
# 3) 웹훅 위조 방지용 임의 문자열 — 직접 아무 값이나 정해서 넣으세요
# TELEGRAM_WEBHOOK_SECRET=아무_긴_임의문자열
# 4) 알림 메시지에 붙일 앱 주소 (Vercel 은 자동 감지되므로 보통 생략 가능)
# APP_URL=https://acm-workspace.vercel.app

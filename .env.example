# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  cp .env.example .env

# Supabase 연결 문자열 (필수)
# Supabase 대시보드 → Project Settings → Database → Connection string
#   - 서버리스(Vercel)에서는 "Connection pooling"(Transaction, 포트 6543) 문자열 권장
#   - 비밀번호 부분([YOUR-PASSWORD])을 실제 DB 비밀번호로 교체
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# 세션 유효시간(시간) — 선택
SESSION_HOURS=12

# 로컬에서 DB 없이 데모로 띄울 때만 사용(인메모리, 재시작 시 초기화)
# USE_PG_MEM=1

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["icn1"],
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "headers": [
    {
      "//": "public/ 안의 파일은 Vercel 엣지가 Express 보다 먼저 처리하므로 server.js 의 헤더가 닿지 않는다. 폰트는 2MB 불변 파일이라 여기서 직접 1년 캐시를 건다(교체 시 파일명 변경).",
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
